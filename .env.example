# ML Guardian Environment Configuration
# Copy this to .env and fill in your values

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ml-guardian

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#ml-alerts

# Guardian Settings
DRIFT_CHECK_INTERVAL_MINUTES=30
DRIFT_THRESHOLD=0.15
PERFORMANCE_DROP_THRESHOLD=0.05
AB_TEST_SAMPLE_SIZE=1000
AB_TEST_CONFIDENCE=0.95

# EU AI Act
AI_SYSTEM_NAME=credit-risk-classifier
AI_RISK_CATEGORY=high-risk
ORGANIZATION_NAME=Your Organization
DEPLOYER_COUNTRY=NL

# Paths
MODEL_ARTIFACTS_PATH=./artifacts
REPORTS_PATH=./reports_output
AUDIT_LOG_PATH=./audit_logs
DATA_PATH=./data
